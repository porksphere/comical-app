#!/usr/bin/env bash
# Operator CLI for the remote dev server. Installed to /usr/local/bin/comical-dev by bootstrap.sh.
#
#   comical-dev status        what is being served right now
#   comical-dev pin 124       stop following pushes; hold PR #124 (survives new pushes to others)
#   comical-dev unpin         resume following the most recently pushed open PR
#   comical-dev logs [metro|watch] [-f]   (-f follows; default prints and exits)
#   comical-dev restart       force a Metro restart (rarely needed; the watcher does this itself)
#
# `pin` only writes state — the watcher picks it up on its next cycle (<=15s) rather than being
# signalled, so this stays a plain file edit with no IPC to get wrong.
set -euo pipefail

STATE_DIR="${DEV_STATE_DIR:-/var/lib/comical-dev}"
STATE="$STATE_DIR/state.json"
STATUS="$STATE_DIR/status.json"

case "${1:-status}" in
  status)
    [ -f "$STATUS" ] || { echo "no status yet — is comical-prwatch running?"; exit 1; }
    jq . "$STATUS"
    ;;
  pin)
    n="${2:?usage: comical-dev pin <pr-number>}"
    tmp="$(mktemp)"; jq --arg n "$n" '.pinned = $n' "$STATE" > "$tmp" && sudo mv "$tmp" "$STATE"
    echo "pinned to PR #$n (applies within ~15s)"
    ;;
  unpin)
    tmp="$(mktemp)"; jq '.pinned = null' "$STATE" > "$tmp" && sudo mv "$tmp" "$STATE"
    echo "unpinned — following most recent push again"
    ;;
  logs)
    # Prints and exits by default. It used to always -f, which meant `comical-dev logs metro | tail`
    # hung forever with no output — journalctl never closed the stream, so tail never saw EOF and
    # printed nothing. Pass -f explicitly to follow.
    follow=""
    [ "${3:-}" = "-f" ] || [ "${2:-}" = "-f" ] && follow="-f"
    case "${2:-metro}" in
      metro|-f) exec journalctl -u comical-metro.service $follow -n 200 --no-pager ;;
      watch) exec journalctl -u comical-prwatch.service $follow -n 200 --no-pager ;;
      *) echo "usage: comical-dev logs [metro|watch] [-f]" >&2; exit 2 ;;
    esac
    ;;
  restart) sudo systemctl restart comical-metro.service && echo "metro restarting" ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
