[Unit]
# Metro, serving the JS bundle to the dev-client build on your phone over Tailscale.
#
# This unit is restarted BY comical-prwatch.service whenever it moves the checkout in a way Metro
# can't hot-reload (branch switch, dependency change, native config change). It is not an
# `expo start` you ever run by hand — the watcher owns which commit is on disk.
Description=Comical Metro dev server (expo start --dev-client)
Documentation=https://github.com/porksphere/comical-app/blob/main/infra/dev-server/README.md
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=comical
Group=comical
WorkingDirectory=/opt/comical/app/apps/mobile
EnvironmentFile=/etc/comical-dev/env
# CI=1 keeps `expo start` non-interactive (no "port in use?" prompt, no keypress menu — there is no
# terminal attached); BROWSER=none stops it trying to open one.
Environment=CI=1
Environment=BROWSER=none
Environment=BUN_INSTALL=/opt/comical/.bun
# --dev-client (not --web, not Expo Go) serves the native bundle the dev-client shell expects; the
# hostname it advertises in the printed URL comes from REACT_NATIVE_PACKAGER_HOSTNAME in the env
# file, which is the box's MagicDNS name. Same invocation as dev-device.ts, minus the LAN-IP sniffing.
ExecStart=/opt/comical/.bun/bin/bunx expo start --dev-client --port ${METRO_PORT}
Restart=always
RestartSec=3
# Metro's first bundle on a cold cache is ~50s and it holds the whole module graph in memory.
TimeoutStartSec=300
KillMode=mixed
# Metro re-parents a worker that keeps holding the port (the reason dev.ts sweeps it by PID) —
# KillMode=mixed plus a generous stop timeout lets systemd take the whole cgroup down cleanly.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
