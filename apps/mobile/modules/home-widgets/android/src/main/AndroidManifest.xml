<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <receiver
      android:name="expo.modules.homewidgets.HistoryWidgetReceiver"
      android:exported="true"
      android:label="@string/home_widget_history_title">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/home_widget_history_info" />
    </receiver>
    <receiver
      android:name="expo.modules.homewidgets.ActivityWidgetReceiver"
      android:exported="true"
      android:label="@string/home_widget_activity_title">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/home_widget_activity_info" />
    </receiver>
  </application>
</manifest>
