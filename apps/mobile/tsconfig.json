{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@comical/host-rn": [
        "../../external/comical/packages/host-rn/src/index.ts"
      ],
      "@comical/host-server/router": [
        "../../external/comical/packages/host-server/src/router.ts"
      ],
      "@comical/host-server/bridge-provider": [
        "../../external/comical/packages/host-server/src/bridge-provider.ts"
      ],
      "@comical/core/loader": [
        "../../external/comical/packages/core/src/loader.ts"
      ],
      "@comical/core/tracker-loader": [
        "../../external/comical/packages/core/src/tracker-loader.ts"
      ],
      "@comical/core/net/rate-limiter": [
        "../../external/comical/packages/core/src/net/rate-limiter.ts"
      ],
      "@comical/contract": [
        "../../external/comical/packages/contract/src/index.ts"
      ],
      "@comical/library": [
        "../../external/comical/packages/library/src/index.ts"
      ],
      "@comical/sync": [
        "../../external/comical/packages/sync/src/index.ts"
      ],
      "@comical/sync/conformance": [
        "../../external/comical/packages/sync/src/conformance.ts"
      ],
      "@comical/downloads": [
        "../../external/comical/packages/downloads/src/index.ts"
      ],
      "@comical/runtime": [
        "../../external/comical/packages/runtime/src/index.ts"
      ],
      "@comical/registry": [
        "../../external/comical/packages/registry/src/schema.ts"
      ],
      "@comical/registry/schema": [
        "../../external/comical/packages/registry/src/schema.ts"
      ],
      "@comical/registry/fetcher": [
        "../../external/comical/packages/registry/src/fetcher.ts"
      ],
      "@comical/registry/url": [
        "../../external/comical/packages/registry/src/url.ts"
      ],
      // The react-native-screens 5.0 beta's `reanimated` entry names lib/*/reanimated, which its build
      // writes to lib/*/legacy/reanimated. Bundles are fine (iOS, the one importer, reads the entry's
      // react-native field); this points the types at the same place. Drop once a release matches.
      "react-native-screens/reanimated": [
        "../../node_modules/react-native-screens/lib/typescript/legacy/reanimated/index.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
