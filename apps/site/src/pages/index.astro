---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getImage } from 'astro:assets';
import DeviceFrame from '../components/DeviceFrame.astro';
import PlatformPicker from '../components/PlatformPicker.astro';
import { href, links } from '../lib/links';
import browse from '../assets/screens/01-browse.png';
import series from '../assets/screens/02-series.png';
import reader from '../assets/screens/03-reader.png';
import desktop from '../assets/screens/04-desktop.png';

// Starlight's hero takes its image as raw HTML, so the phone there is the DeviceFrame markup by
// hand, over the same optimised asset and the same global .device styles.
const hero = await getImage({ src: browse, widths: [440, 720], sizes: '(max-width: 50rem) 70vw, 25rem', format: 'webp' });
const heroHtml = `<figure class="device not-content device-phone"><img src="${hero.src}" srcset="${hero.srcSet.attribute}" sizes="${hero.attributes.sizes}" width="${hero.attributes.width}" height="${hero.attributes.height}" alt="Browsing featured series on a phone" loading="eager" fetchpriority="high" decoding="async"></figure>`;
---

<StarlightPage
  frontmatter={{
    title: 'Comical',
    description: 'A comic reader for iOS, Android, desktop and the web.',
    template: 'splash',
    hero: {
      title: 'A comic reader for every screen you own.',
      tagline:
        'Comics, manga and webtoons on your phone, your computer or in a browser. Save what you follow, read offline, and keep up with new chapters.',
      image: { html: heroHtml },
      actions: [
        { text: 'Download', link: '#download', icon: 'down-caret', variant: 'primary' },
        { text: 'Try the demo', link: href('demo/'), icon: 'rocket', variant: 'secondary' },
        { text: 'Read the docs', link: href('getting-started/'), icon: 'right-arrow', variant: 'minimal' },
      ],
    },
  }}
>
  <section class="feature">
    <div class="copy">
      <h2>Made for reading</h2>
      <p>
        Pages, long strips and right-to-left manga all read the way they were drawn. Pinch to look
        closer, swipe to the next chapter, and pick up exactly where you left off.
      </p>
      <a href={href('guides/reader/')}>Reader guide →</a>
    </div>
    <DeviceFrame src={reader} alt="The reader, with a page shown full-bleed" />
  </section>

  <section class="feature reverse">
    <div class="copy">
      <h2>Your library, with you</h2>
      <p>
        Save the series you follow and sort them into collections. Download chapters to read
        offline, or let new chapters download themselves as they come out.
      </p>
      <a href={href('guides/library/')}>Library →</a> · <a href={href('guides/downloads/')}>Downloads →</a>
    </div>
    <DeviceFrame src={series} alt="A series page with resume, library, download and tracker actions" />
  </section>

  <section class="feature">
    <div class="copy">
      <h2>Never miss a chapter</h2>
      <p>
        One feed of everything new across the series you follow, with notifications on your phone.
        AniList and MyAnimeList stay up to date with what you've read.
      </p>
      <a href={href('guides/activity/')}>Activity →</a> · <a href={href('guides/tracking/')}>Tracking →</a>
    </div>
    <DeviceFrame src={browse} alt="Browse, with new and hot badges on series" />
  </section>

  <section class="desktop">
    <h2>On your computer too</h2>
    <p>
      A desktop app for Windows and Linux, and a web app you can host yourself. Your phone and
      computer keep your library and reading progress in sync over your home network, with no
      account to sign up for.
    </p>
    <DeviceFrame src={desktop} alt="Browsing in the desktop app" kind="window" class="wide" />
    <p class="links">
      <a href={href('guides/sync/')}>Sync →</a> · <a href={href('guides/keyboard-shortcuts/')}>Keyboard shortcuts →</a>
    </p>
  </section>

  <section class="try">
    <h2>See it before you install it</h2>
    <p>
      The demo is the real app running in your browser on sample data. Browse, open a series, read
      a chapter, save it to a library. Nothing to install and nothing to sign in to.
    </p>
    <a class="btn" href={href('demo/')}>Open the demo</a>
  </section>

  <section class="how">
    <h2>How it works</h2>
    <ol class="not-content">
      <li>
        <strong>Registry</strong>
        <span>A list of bridges you add in Settings. Public ones are tagged <a href={links.registryTopic}><code>comical-registry</code></a> on GitHub.</span>
      </li>
      <li>
        <strong>Bridge</strong>
        <span>An adapter for one source or service, downloaded and verified from a registry. On a phone, bridges run on the device; on the web, on the server you host.</span>
      </li>
      <li>
        <strong>Series</strong>
        <span>What a bridge sources, and what you browse, save and read.</span>
      </li>
    </ol>
    <p class="links"><a href={href('concepts/')}>More on registries, bridges and trackers →</a></p>
  </section>

  <section class="download" id="download">
    <h2>Download</h2>
    <PlatformPicker />
  </section>

  <footer class="fine">
    <p>
      Screenshots show sample data. The comic pages pictured are from
      <a href="https://www.peppercarrot.com"><em>Pepper&amp;Carrot</em></a> by David Revoy,
      <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
    </p>
  </footer>
</StarlightPage>

<style>
  /* The header search is the docs' search; it has nothing to find on this page. */
  :global(site-search) {
    display: none;
  }
  section {
    margin-block: clamp(3rem, 8vw, 6rem);
  }
  h2 {
    font-size: clamp(var(--sl-text-2xl), calc(0.5rem + 2.5vw), var(--sl-text-4xl));
    font-weight: 600;
    color: var(--sl-color-white);
    line-height: 1.15;
    margin: 0 0 0.75rem;
  }
  p {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-lg);
    line-height: 1.6;
    margin: 0 0 1rem;
  }
  a {
    color: var(--sl-color-text-accent);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }

  .feature {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .feature :global(.device) {
    width: min(70%, 18rem);
    justify-self: center;
  }
  @media (min-width: 50rem) {
    .feature {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
    .feature.reverse .copy {
      order: 2;
    }
  }

  .desktop,
  .try,
  .how {
    text-align: center;
  }
  .desktop p,
  .try p,
  .how > p {
    max-width: 60ch;
    margin-inline: auto;
  }
  .try {
    padding: clamp(2rem, 5vw, 3.5rem) 1.5rem;
    border-radius: 18px;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-hairline-light);
  }
  .try .btn {
    display: inline-block;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    background: var(--sl-color-accent);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
  .try .btn:hover {
    background: #5a90ff;
    text-decoration: none;
  }
  .desktop :global(.wide) {
    margin: 2rem auto;
    max-width: 60rem;
  }
  .links {
    font-size: var(--sl-text-base);
  }

  .how ol {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
    display: grid;
    gap: 1rem;
    counter-reset: step;
    text-align: start;
  }
  @media (min-width: 50rem) {
    .how ol {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .how li {
    counter-increment: step;
    padding: 1.25rem;
    border-radius: 14px;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-hairline-light);
    display: grid;
    align-content: start;
    gap: 0.5rem;
  }
  .how li::before {
    content: counter(step);
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--sl-color-accent);
    color: #fff;
    font-weight: 700;
    font-size: var(--sl-text-sm);
    display: grid;
    place-items: center;
  }
  .how strong {
    color: var(--sl-color-white);
    font-size: var(--sl-text-lg);
  }
  .how span {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }

  .download h2 {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .fine {
    margin-block: 3rem 1rem;
    text-align: center;
  }
  .fine p {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
