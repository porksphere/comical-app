---
/**
 * A screenshot in an abstract device. A bezel and a radius are all a phone needs to read as one
 * — the captures already carry the status bar and a device-ratio corner (scripts/shape-screenshots.py)
 * — and a window needs a title strip. No vendor bezel art: it's megabytes per PNG, goes stale with
 * the hardware, and carries trade dress this site has no business reproducing. Styles are in
 * styles/device.css, shared with the hero's raw-HTML copy of this markup.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  kind?: 'phone' | 'tablet' | 'window';
  /** CSS width of the whole device, any unit. */
  width?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { src, alt, kind = 'phone', width, class: className, loading = 'lazy' } = Astro.props;
const sizes = kind === 'window' ? '(max-width: 60rem) 92vw, 60rem' : '(max-width: 40rem) 70vw, 22rem';
---

<figure class:list={['device', `device-${kind}`, className]} style={width ? `width:${width}` : undefined}>
  {kind === 'window' && (
    <div class="titlebar" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
  )}
  <Image src={src} alt={alt} loading={loading} widths={[440, 720, 1360]} sizes={sizes} />
</figure>
