+  // A menu row (Menu/Picker) draws a Label's icon as a plain UIImage, so no image modifier reaches
+  // it: the file is decoded at the screen's scale, and the radius of a `cornerRadius` modifier is
+  // baked into the bitmap here. Elsewhere the modifier still clips as usual (twice is harmless).
+  private func rounded(_ image: UIImage) -> UIImage {
+    let radius = props.modifiers?.compactMap { modifier -> Double? in
+      guard modifier["$type"] as? String == "cornerRadius" else { return nil }
+      return modifier["radius"] as? Double
+    }.first ?? 0
+    guard radius > 0 else { return image }
+    let format = UIGraphicsImageRendererFormat()
+    format.scale = image.scale
+    format.opaque = false
+    let bounds = CGRect(origin: .zero, size: image.size)
+    return UIGraphicsImageRenderer(size: image.size, format: format).image { _ in
+      UIBezierPath(roundedRect: bounds, cornerRadius: CGFloat(radius)).addClip()
+      image.draw(in: bounds)
+    }
+  }
+
