+// UIKit's own resolution for `tabBarMinimizeBehavior` only walks the first-subview chain
+// (mirroring `findScrollViewInFirstDescendantChainFrom`), so it never finds a UIScrollView
+// that isn't literally the first child at every level - e.g. a screen that has its own
+// top-bar overlay sibling, or a virtualized list wrapped by intermediate views. Without an
+// override, `tabBarMinimizeBehavior` is silently inert on such screens - see
+// https://github.com/software-mansion/react-native-screens/issues/4145. Fall back to a
+// bounded breadth-first search so there's still something for the tab bar to track.
+//
+// Answer for every edge, not just .bottom: the minimize behavior's "user is scrolling back
+// up" tracking depends on resolving the SAME scroll view UIKit asks about for other edges
+// (e.g. .top) too. Restricting the fallback to .bottom left those queries returning nil,
+// so the bar would minimize on scroll down but only ever re-expand once content actually
+// reached its top edge - not on every upward scroll, as tabBarMinimizeBehavior promises.
+- (nullable UIScrollView *)contentScrollViewForEdge:(NSDirectionalRectEdge)edge API_AVAILABLE(ios(26.0))
+{
+  UIScrollView *scrollView = [super contentScrollViewForEdge:edge];
+  if (scrollView != nil) {
+    return scrollView;
+  }
+
+  return [RNSScrollViewFinder findScrollViewBreadthFirstFrom:self.view];
+}
