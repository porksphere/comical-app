 + (nullable UIScrollView *)findContentScrollViewWithDelegatingToProvider:(nullable UIView *)view;
 
+/**
+ * Searches for a vertically-scrollable UIScrollView anywhere in `view`'s subtree using a bounded
+ * breadth-first search, instead of only the first-subview chain. Unlike
+ * `findScrollViewInFirstDescendantChainFrom`, this succeeds even when the content scroll view isn't
+ * the first child at every level (e.g. a screen with an overlay/header sibling, or a virtualized
+ * list wrapped by intermediate views) - see
+ * https://github.com/software-mansion/react-native-screens/issues/4145.
+ *
+ * Horizontal-only scrollers (carousels/rails) are skipped so a nested horizontal list doesn't get
+ * mistaken for the screen's main scrollable content; their subtrees are not descended into.
+ * The search is capped at a fixed number of visited views as a safety bound against pathological
+ * hierarchies.
+ *
+ * When `view == nil`, it should also return `nil`.
+ */
++ (nullable UIScrollView *)findScrollViewBreadthFirstFrom:(nullable UIView *)view;
+
 @end
diff --git a/node_modules/react-native-screens/ios/helpers/scroll-view/RNSScrollViewFinder.mm b/node_modules/react-native-screens/ios/helpers/scroll-view/RNSScrollViewFinder.mm
index 2434c61..c3a5e2f 100644
--- a/node_modules/react-native-screens/ios/helpers/scroll-view/RNSScrollViewFinder.mm
+++ b/node_modules/react-native-screens/ios/helpers/scroll-view/RNSScrollViewFinder.mm
@@ -41,4 +41,54 @@
   return nil;
 }
 
+// Bounded so a pathological view tree can't turn this into an unbounded scan.
+static const NSUInteger kRNSScrollViewFinderMaxVisitedViews = 2000;
+
++ (BOOL)rnscreens_isVerticallyScrollableCandidate:(UIScrollView *)scrollView
+{
+  CGFloat height = scrollView.bounds.size.height;
+  CGFloat width = scrollView.bounds.size.width;
+  if (height <= 0 && width <= 0) {
+    // Not laid out yet - don't rule it out based on size we don't have.
+    return YES;
+  }
+
+  BOOL scrollsVertically = scrollView.contentSize.height > height + 1;
+  BOOL scrollsHorizontally = scrollView.contentSize.width > width + 1;
+
+  // Only reject scrollers that are horizontal-only (e.g. a rail/carousel nested in a header);
+  // anything that can scroll vertically, or whose axis is ambiguous, is a valid candidate.
+  return scrollsVertically || !scrollsHorizontally;
+}
+
++ (nullable UIScrollView *)findScrollViewBreadthFirstFrom:(nullable UIView *)view
+{
+  if (view == nil) {
+    return nil;
+  }
+
+  NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:view];
+  NSUInteger head = 0;
+  NSUInteger visited = 0;
+
+  while (head < queue.count && visited < kRNSScrollViewFinderMaxVisitedViews) {
+    UIView *current = queue[head++];
+    visited++;
+
+    if ([current isKindOfClass:UIScrollView.class]) {
+      UIScrollView *scrollView = static_cast<UIScrollView *>(current);
+      if ([self rnscreens_isVerticallyScrollableCandidate:scrollView]) {
+        return scrollView;
+      }
+      // Horizontal-only scroller: not a candidate, and its content isn't part of the
+      // screen's own scrollable surface, so don't descend into it.
+      continue;
+    }
+
+    [queue addObjectsFromArray:current.subviews];
+  }
+
+  return nil;
+}
+
 @end
