+    return rect;
+  }
+  const m = new DOMMatrixReadOnly(transform);
+  const width = rect.width / (m.a || 1);
+  const height = rect.height / (m.d || 1);
+  return new DOMRect(
+    rect.x - m.e + (rect.width - width) / 2,
+    rect.y - m.f + (rect.height - height) / 2,
+    width,
+    height
