+ * back out. `getBoundingClientRect` reports where the element is DRAWN; mid-animation that is
+ * somewhere between the previous slot and the current one, and a transition computed from it
+ * starts at the previous slot instead of where the element visibly is. Transitions here only
+ * translate and scale about the centre, so that is all that is undone.
+ */
+function untransformedRect(element: HTMLElement, rect: DOMRect): DOMRect {
+  const transform = getComputedStyle(element).transform;
+  if (
+    !transform ||
